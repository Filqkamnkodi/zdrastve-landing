# Online booking (server-only, set in Vercel → Settings → Environment Variables)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_ID_SHUMEN=
GOOGLE_CALENDAR_ID_NOVI_PAZAR=
# The preceding calendar names are historical: one calendar per doctor, at both clinics.
GOOGLE_CALENDAR_ID_SIMANA=
# Optional: force demo mode on a non-production deploy
BOOKING_DEMO_MODE=
